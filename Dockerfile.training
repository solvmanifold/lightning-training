FROM nvcr.io/nvidia/nemo:25.02

# Triton 3.1.0 (bundled with NeMo 25.02) doesn't recognise sm_121 (GB10).
# 3.2.0+ added SM121 support; resolves to 3.6.0 at the time of writing.
RUN pip install -q 'triton>=3.2.0'

# causal_conv1d's pre-built kernels don't support GB10 (SM121).
# train.py patches the module at startup to force torch_forward() instead.
# No recompilation needed — just install LoRA + plotting + DPO/GRPO deps on top.
# Version pins:
#   trl<0.13         — trl 0.13+ imports torch.distributed.fsdp.FSDPModule which
#                      isn't in the torch shipped with NeMo 25.02.
#   bitsandbytes>=0.46.1 — required by transformers' bnb 4-bit quantizer.
RUN pip install -q peft matplotlib tensorboard openai rouge_score \
                  'trl<0.13' 'bitsandbytes>=0.46.1'

WORKDIR /workspace