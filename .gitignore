outputs/debug/
outputs/overfit_*/checkpoints/
outputs/sft/checkpoints/
outputs/dpo/checkpoints/
outputs/qlora/checkpoints/
outputs/grpo/checkpoints/
outputs/sweeps/

# HuggingFace cache (separate from repo)
.cache/

# We keep these (small but useful):
